{
	"$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
	"files": {
		"includes": [
			"**",
			"!!**/.next",
			"!!**/node_modules",
			"!!**/.git",
			"!!**/.turbo",
			"!!**/dist",
			"!!**/out",
			"!!**/build",
			"!!**/.cache",
			"!!**/coverage"
		]
	},
	"formatter": {
		"formatWithErrors": false,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"linter": {
		"rules": {
			"recommended": true,
			"correctness": { "recommended": true },
			"suspicious": { "recommended": true },
			"style": {
				"recommended": true,
				"useConsistentTypeDefinitions": "error",
				"useImportType": "error",
				"useExportType": "error"
			},
			"complexity": { "recommended": true },
			"performance": { "recommended": true },
			"security": { "recommended": true },
			"a11y": { "recommended": true },
			"nursery": { "recommended": false }
		},
		"domains": {
			"react": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"trailingCommas": "es5",
			"semicolons": "asNeeded",
			"arrowParentheses": "asNeeded",
			"bracketSpacing": true,
			"bracketSameLine": false
		},
		"globals": ["React"]
	},
	"overrides": [
		{
			"includes": ["**/*.css"],
			"css": {
				"parser": {
					"tailwindDirectives": true
				}
			}
		},
		{
			"includes": ["**/*.test.{ts,tsx,js,jsx}", "**/*.spec.{ts,tsx,js,jsx}"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"next.config.{ts,js,mjs}",
				"*.config.{ts,js,mjs}",
				"tailwind.config.{ts,js,mjs}",
				"vitest.config.{ts,js,mjs}"
			],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/ui/**/*"],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": "off",
						"useFocusableInteractive": "off",
						"useSemanticElements": "off",
						"useKeyWithClickEvents": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/shared/**/*"],
			"linter": {
				"rules": {
					"a11y": {
						"useAnchorContent": "off"
					}
				}
			}
		}
	]
}
